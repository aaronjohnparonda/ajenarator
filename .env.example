# AJenarator environment settings
# 1. Copy this file and name the copy ".env" (same folder).
# 2. Fill in the values from your Aiven MySQL service "Overview" page.
# 3. Never commit .env - it is listed in .gitignore.

# --- Aiven MySQL ---
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# CA certificate downloaded from Aiven.
# Local use: save the file as certs/aiven-ca.pem and keep this path.
DB_CA_CERT_PATH=certs/aiven-ca.pem

# Hosting (Render) use instead: paste the full certificate text into DB_CA_CERT
# and leave DB_CA_CERT_PATH empty. DB_CA_CERT wins when both are set.
# DB_CA_CERT=

# --- Google sign-in (optional: leave all three empty to turn sign-in off) ---
# OAuth Client ID from Google Cloud > Google Auth Platform > Clients (Web application).
GOOGLE_CLIENT_ID=
# Who may sign in. One or more Gmail addresses, separated by commas.
OWNER_EMAILS=
# Long random secret that signs the login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out.
JWT_SECRET=

# --- Hosting (optional; only needed on Render) ---
# How many proxies sit in front of the app. Measure with SHOW_IP_CHECK, don't guess. Default 1.
# TRUST_PROXY_HOPS=1
# Set to true TEMPORARILY to enable /api/v1/ip-check for that measurement, then remove it.
# SHOW_IP_CHECK=false
# Set to true on Render (kept awake by an uptime monitor) so the server checks PCSO for new
# results itself, every 10 minutes after the draw. Leave unset on your laptop.
# AUTO_FETCH_RESULTS=false
