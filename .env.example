# AJenarator environment settings
# 1. Copy this file and name the copy ".env" (same folder).
# 2. Fill in the values from your Aiven MySQL service "Overview" page.
# 3. Never commit .env - it is listed in .gitignore.

# --- Aiven MySQL ---
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# CA certificate downloaded from Aiven.
# Local use: save the file as certs/aiven-ca.pem and keep this path.
DB_CA_CERT_PATH=certs/aiven-ca.pem

# Hosting (Render) use instead: paste the full certificate text into DB_CA_CERT
# and leave DB_CA_CERT_PATH empty. DB_CA_CERT wins when both are set.
# DB_CA_CERT=
